---
interface Props {
  src?: string;
  alt?: string;
}
const { src = '/images/blog-placeholder.svg', alt = '' } = Astro.props;
---

<div class="blog-cover-frame">
  <img class="blog-cover" src={src} alt={alt} width="960" height="540" loading="lazy" decoding="async" />
</div>

<style>
  .blog-cover-frame {
    width: 100%;
    aspect-ratio: 16 / 9;
    margin: 1rem 0;
    overflow: hidden;
  }

  .blog-cover-frame img.blog-cover:not(.pfp) {
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: cover;
  }
</style>
