---
import '../styles/kangel.css';
---

<div id="bonsai-window">
  <div class="window hoverable-window">
    <div class="title-bar">
      <div class="btn box"></div>
      <div class="title">bonsai.exe</div>
      <div class="window-controls">
        <div class="btn close"></div>
        <div class="btn minimize"></div>
        <div class="btn maximize"></div>
      </div>
    </div>

    <div class="content">
      <!-- Painted by /scripts/bonsai.js from the frame data in
           /scripts/bonsai-frames.js. -->
      <canvas id="bonsai-canvas" class="bonsai" role="img" aria-label="A pink bonsai tree swaying in the wind, drawn as a mosaic of colour blocks and dots"></canvas>
    </div>

    <div class="bottom-bar">
      <div class="btmbtn main"></div>
      <div class="btmbtn small"></div>
      <div class="btmbtn small"></div>
      <div class="btmbtn small"></div>
    </div>
  </div>
</div>
