---
import pfp from '../assets/pfp.jpeg';
import '../styles/kangel.css';
import Greeting from '../components/Greeting.astro';
import { getEntry, render } from 'astro:content';

const welcomeEntry = await getEntry('welcome', 'welcome');
const { Content } = await render(welcomeEntry);
---


<div id="container">
  <div id="container2">
    <div class="window hoverable-window">
      <div class="title-bar">
        <div class="btn box"></div>
        <div class="title">welcome.txt</div>
        <div class="window-controls">
          <div class="btn close"></div>
          <div class="btn minimize"></div>
          <div class="btn maximize"></div>
        </div>
      </div>

      <div class="content">
        <div class="intro-flex">
          <img src={pfp.src} alt="Profile picture" class="pfp" />
          <div>
            <h1><Greeting /></h1>
            <ul>
              {welcomeEntry.data.roles.map(role => (
                <li><strong>{role.includes(' @ ') ? <><span>{role.split(' @ ')[0]}</span>{' '}<span class="role-organization">@ {role.split(' @ ')[1]}</span></> : role}</strong></li>
              ))}
            </ul>
          </div>
        </div>
        <div class="welcome-body">
          <Content />
        </div>
      </div>

      <div class="bottom-bar">
        <div class="btmbtn main"></div>
        <div class="btmbtn small"></div>
        <div class="btmbtn small"></div>
        <div class="btmbtn small"></div>
      </div>
    </div>
  </div>
</div>

<script>
  const contactRow = document.querySelector<HTMLElement>('.welcome-contact p');
  if (contactRow) {
    const fitContactLinks = () => {
      contactRow.style.removeProperty('--contact-font-size');
      if (!document.body.classList.contains('nav-collapsed')) return;
      const availableWidth = contactRow.clientWidth;
      if (!availableWidth) return;
      const textRange = document.createRange();
      textRange.selectNodeContents(contactRow);
      const textWidth = textRange.getBoundingClientRect().width;
      if (textWidth > availableWidth) {
        const normalSize = parseFloat(getComputedStyle(contactRow).fontSize);
        contactRow.style.setProperty('--contact-font-size', `${normalSize * (availableWidth - 1) / textWidth}px`);
      }
    };
    let previousWidth = -1;
    new ResizeObserver(([entry]) => {
      if (entry.contentRect.width === previousWidth) return;
      previousWidth = entry.contentRect.width;
      fitContactLinks();
    }).observe(contactRow);
    window.addEventListener('resize', fitContactLinks);
    document.fonts.ready.then(fitContactLinks);
    fitContactLinks();
  }
</script>

<style>
  .intro-flex .pfp {
    width: var(--profile-size, 160px);
    height: auto;
    aspect-ratio: 1;
    flex-shrink: 0;
  }
  .intro-flex > div { flex: 1; min-width: 0; }
  .intro-flex h1 { line-height: 1.2; }
  :global(body.nav-collapsed) .intro-flex .pfp {
    width: var(--profile-size, 100px);
    height: auto;
  }
  :global(body.nav-collapsed) .intro-flex {
    display: grid;
    grid-template-columns: var(--profile-size, 100px) minmax(0, 1fr);
    align-items: center;
    text-align: left;
  }
  :global(body.nav-collapsed) .intro-flex > div { display: contents; }
  :global(body.nav-collapsed) .intro-flex h1 { margin-bottom: 0; }
  .role-organization { white-space: nowrap; }
  .intro-flex li { text-wrap: balance; }

  :global(body.nav-collapsed) .intro-flex > div { width: 100%; min-width: 0; }
  :global(body.nav-collapsed) .intro-flex h1 { line-height: 1.35; }
  :global(body.nav-collapsed) .intro-flex ul {
    grid-column: 1 / -1;
    width: auto;
    margin: 1rem 0 0 1.5rem;
    padding-left: 0;
    list-style: disc outside;
    line-height: 1.5;
    text-align: left;
    text-align-last: auto;
  }
  :global(body.nav-collapsed) .intro-flex li { text-wrap: wrap; }
  :global(body.nav-collapsed) .role-organization { display: inline; }
  :global(body.nav-collapsed) .intro-flex li + li { margin-top: 0.6rem; }
</style>
