---
import { getCollection } from 'astro:content';
import '../styles/kangel.css';
import DirectoryLinks from './DirectoryLinks.astro';
const posts = (await getCollection('ctfblog')).sort(
  (a, b) => Date.parse(b.data.date) - Date.parse(a.data.date),
);
const writeups = await getCollection('writeups');

const writeupsByCompetition = new Map<string, typeof writeups>();
for (const writeup of writeups) {
  const group = writeupsByCompetition.get(writeup.data.competition) ?? [];
  group.push(writeup);
  writeupsByCompetition.set(writeup.data.competition, group);
}

// Newest competition year first (e.g. "Lag N Crash 2025" above "Lag N Crash 2024").
const competitionYear = (name: string) => Number(name.match(/\d{4}/)?.[0] ?? 0);
const sortedCompetitions = [...writeupsByCompetition.entries()].sort(
  ([a], [b]) => competitionYear(b) - competitionYear(a) || a.localeCompare(b),
);
---

<div id="container">
  <div id="container2">
    <div class="window hoverable-window">
      <div class="title-bar">
        <div class="btn box"></div>
        <div class="title">ctf blog.txt</div>
        <div class="window-controls">
          <div class="btn close"></div>
          <div class="btn minimize"></div>
          <div class="btn maximize"></div>
        </div>
      </div>

      <div class="content">
        <h1>ctf</h1>
        <DirectoryLinks />
        <p>Writeups for challenges I created and challenges I solved.</p>

        <div id="writeups">
          <section id="created" aria-labelledby="created-heading">
          <h2 id="created-heading">Writeups - Challenge author</h2>
          <ul>
            {posts.filter(post => post.data.type === 'created').map(post => (
              <li><a href={`/ctfblog/${post.slug}/`}>{post.data.title}</a> — {post.data.date}</li>
            ))}
          </ul>
          {sortedCompetitions.map(([competition, entries]) => (
            <div class="writeup-group">
              <h3>{competition}</h3>
              <ul>
                {entries.map(writeup => (
                  <li>
                    <a href={`/ctfblog/writeups/${writeup.id}/`}>{writeup.data.challenge}</a>
                    <div class="tag-row">
                      {writeup.data.category && <span class="tag">{writeup.data.category}</span>}
                      {writeup.data.difficulty && <span class="tag">{writeup.data.difficulty}</span>}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))}
          </section>
          <section id="solved" aria-labelledby="solved-heading">
            <h2 id="solved-heading">Writeups - Solved Challenges</h2>
            {posts.some(post => post.data.type === 'solved') ? (
              <ul>
                {posts.filter(post => post.data.type === 'solved').map(post => (
                  <li><a href={`/ctfblog/${post.slug}/`}>{post.data.title}</a> — {post.data.date}</li>
                ))}
              </ul>
            ) : <p>No writeups here yet.</p>}
          </section>
        </div>
      </div>

      <div class="bottom-bar">
        <div class="btmbtn main"></div>
        <div class="btmbtn small"></div>
        <div class="btmbtn small"></div>
        <div class="btmbtn small"></div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Keep the marker outside the text column so wrapped tags line up with
     the question text even in the mobile layout's inside-marker lists. */
  #writeups .writeup-group ul {
    padding-left: 1.2em;
    list-style-position: outside;
  }

  #writeups.tags-below .tag-row {
    display: flex;
    width: fit-content;
    max-width: 100%;
    margin: 0.35rem 0 0;
  }
</style>

<script>
  const writeups = document.querySelector<HTMLElement>('#writeups');
  if (writeups) {
    let frame = 0;
    const updateTags = () => {
      // Measure the natural inline layout each time so widening the window
      // can bring every tag row back alongside its question.
      writeups.classList.remove('tags-below');
      const wrapped = [...writeups.querySelectorAll<HTMLElement>('.writeup-group li')].some(item => {
        const title = item.querySelector('a');
        const row = item.querySelector<HTMLElement>('.tag-row');
        if (!title || !row || !row.children.length) return false;
        const titleLines = title.getClientRects();
        const lastLine = titleLines[titleLines.length - 1];
        const tags = [...row.children].map(tag => tag.getBoundingClientRect());
        return !!lastLine && (
          row.getBoundingClientRect().top >= lastLine.bottom - 1 ||
          tags.some(tag => tag.top > tags[0].top + 1)
        );
      });
      writeups.classList.toggle('tags-below', wrapped);
    };
    const scheduleUpdate = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(updateTags);
    };
    // Watch width only: moving tags changes height and must not trigger a loop.
    let previousWidth = -1;
    new ResizeObserver(entries => {
      const width = entries[0].contentRect.width;
      if (width !== previousWidth) {
        previousWidth = width;
        scheduleUpdate();
      }
    }).observe(writeups);
    new MutationObserver(scheduleUpdate).observe(document.body, { attributes: true, attributeFilter: ['class'] });
    document.fonts.ready.then(scheduleUpdate);
    window.addEventListener('resize', scheduleUpdate);
    scheduleUpdate();
  }
</script>
