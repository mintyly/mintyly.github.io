---
import banner from '../assets/banner_website.png';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
}
const {
  title = 'June Ong',
  description = "June Ong's personal site! portfolio, CTF writeups, and blog.",
  type = 'website',
  image,
  imageAlt = 'June Ong',
} = Astro.props;
const ogImage = new URL(image ?? banner.src, Astro.site);
const canonicalPath = Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/$/, '')}/`;
const canonicalURL = new URL(canonicalPath, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/face.png" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />

		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="June Ong" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content={imageAlt} />
		{!image && <>
			<meta property="og:image:width" content={String(banner.width)} />
			<meta property="og:image:height" content={String(banner.height)} />
		</>}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={imageAlt} />
		<slot name="head" />
	</head>

	<body>
		<slot />
		<script type="module" src="/scripts/sidebar.js"></script>
		<script type="module" src="/scripts/windows.js"></script>
		<script type="module" src="/scripts/lastfm.js"></script>
		<!-- Deferred classic script + module script execute in document order once
		     parsing is done, so window.FRAMES exists before bonsai.js runs. -->
		<script is:inline defer src="/scripts/bonsai-frames.js"></script>
		<script type="module" src="/scripts/bonsai.js"></script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
