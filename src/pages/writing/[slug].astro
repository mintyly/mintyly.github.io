---
import { getCollection, getEntryBySlug } from 'astro:content';
import '../../styles/kangel.css';

// Import your Navbar component
import Navbar from '../../components/Navbar.astro';
import AmeWindow from '../../components/AmeWindow.astro';
import LastFmWindow from '../../components/LastFmWindow.astro';
import TipWindow from '../../components/TipWindow.astro';
import BonsaiWindow from '../../components/BonsaiWindow.astro';
import Layout from '../../layouts/Layout.astro';
import PostWindow from '../../components/PostWindow.astro';
import SpatialPoem from '../../components/SpatialPoem.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: {},
  }));
}

const { slug } = Astro.params;
const post = await getEntryBySlug('writing', slug);

if (!post) {
  throw new Error(`Post not found for slug: ${slug}`);
}

const { Content } = await post.render();
---

<Layout>
  <!-- Include the Navbar at the top -->
  <Navbar />
  <AmeWindow />
  <LastFmWindow />
  <TipWindow />
  <BonsaiWindow />

  <PostWindow title={post.data.title} date={post.data.date}>
    {post.data.spatial ? <SpatialPoem text={post.body} /> : <Content />}
  </PostWindow>
</Layout>
